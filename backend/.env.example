# LLM Configuration
GROQ_API_KEY=your_groq_api_key_here

# Blockchain RPC
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Database
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Block Explorer APIs (Optional)
